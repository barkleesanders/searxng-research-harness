# Reference SearXNG settings for the native install. build-native-searxng.sh writes a
# copy of this to ~/tools/searxng-native/settings.yml with a freshly generated secret_key.
# If you use this file directly, REPLACE secret_key with: openssl rand -hex 32
use_default_settings: true
server:
  bind_address: "127.0.0.1"
  port: 8888
  secret_key: "CHANGE_ME_run_openssl_rand_hex_32"
  limiter: false
  image_proxy: false
search:
  # JSON API MUST be enabled here or the harness cannot parse results.
  formats:
    - html
    - json
# More upstream engines, so one engine being rate-limited does not empty the results.
# The websearch CLI sends each query to only 4 of these in rotation (SEARXNG_FANOUT),
# which spreads load and keeps any single engine from being throttled.
# Measured 2026-09-28: with 6 engines already suspended, 64 queries at 1/s returned
# 0 empty and 60/64 with the expected site in the top 5. Engines tested and left off:
# baidu, qwant, seznam, sogou, yacy and others returned nothing from this host;
# quark answers with a CAPTCHA. duckduckgo timed out on every request.
engines:
  - name: google
    disabled: false
  - name: bing
    disabled: false
  - name: yahoo
    disabled: false
  - name: yep
    disabled: false
  - name: gmx
    disabled: false
  - name: naver
    disabled: false
  - name: resulthunter
    disabled: false
  - name: tusksearch
    disabled: false
  - name: zapmeta
    disabled: false
  - name: yandex
    disabled: false
  - name: fynd
    disabled: false
  - name: mwmbl
    disabled: false
  - name: duckduckgo
    disabled: true
