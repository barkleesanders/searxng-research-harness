# Reference SearXNG settings for the native install. build-native-searxng.sh writes a
# copy of this to ~/tools/searxng-native/settings.yml with a freshly generated secret_key.
# If you use this file directly, REPLACE secret_key with: openssl rand -hex 32
use_default_settings: true
server:
  bind_address: "127.0.0.1"
  port: 8888
  secret_key: "CHANGE_ME_run_openssl_rand_hex_32"
  limiter: false
  image_proxy: false
search:
  # JSON API MUST be enabled here or the harness cannot parse results.
  formats:
    - html
    - json
# More upstream engines, so one engine being rate-limited (suspended ~3 min) does not
# empty the results. With the defaults alone (Google CSE, Brave, DuckDuckGo), 38 of 60
# rapid benchmark queries came back empty; with these added, 60 of 60 answered.
engines:
  - name: google
    disabled: false
  - name: bing
    disabled: false
  - name: yahoo
    disabled: false
  - name: yep
    disabled: false
