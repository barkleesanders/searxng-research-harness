const UNMETERED_BONUS = 0.05;

// Cheap keyword heuristics. Wrong guesses cost little — every provider is still tried
// in order — and --intent overrides.
function detectIntent(q) {
  const s = q.toLowerCase();
  if (
    /\b(today|tonight|yesterday|this (week|month)|latest|breaking|news|headlines|right now|currently|live score|scores|stock market|forecast|weather|election results?)\b/.test(
      s,
    )
  )
    return 'fresh';
  if (
    /\b(error|exception|traceback|typeerror|valueerror|segfault|stack ?trace|undefined is not|cannot find module|npm err|syntax error|compile error|borrow checker)\b/.test(
      s,
    ) ||
    /\b(how (do i|to) .* in (python|javascript|js|typescript|ts|rust|go|golang|bash|sql|swift|java|c\+\+|css|git))\b/.test(
      s,
    ) ||
    /[a-z_]+\(\)|::|=>|\.[a-z_]+\(/i.test(q)
  )
    return 'code';
  if (
    /^(what|who|whom|when|where|which|why|how (many|much|tall|old|long|far|big|fast|deep|high)|is|are|was|were|does|do|did|can|define|meaning of)\b/.test(
      s,
    )
  )
    return 'facts';
  return 'general';
}

