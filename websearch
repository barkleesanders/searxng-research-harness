// ----------------------------------------------------------------------- args
function parseArgs(argv) {
  const o = { num: 5, order: null, provider: null, json: null, timeout: 15000, quiet: false, cooldown: true, query: [] };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '-n' || a === '--num') o.num = Math.max(1, parseInt(argv[++i], 10) || 5);
    else if (a === '--provider' || a === '-p') o.provider = argv[++i];
    else if (a === '--order') o.order = argv[++i].split(',').map((s) => s.trim());
    else if (a === '--json') o.json = true;
    else if (a === '--pretty') o.json = false;
    else if (a === '--timeout') o.timeout = Math.max(1000, parseInt(argv[++i], 10) || 15000);
    else if (a === '--quiet' || a === '-q') o.quiet = true;
    else if (a === '--no-cooldown') o.cooldown = false;
    else if (a === '--intent') o.intent = argv[++i];
    else if (a === '--static') o.static = true;
    else if (a === 'quota' && o.query.length === 0) o.cmd = 'quota';
    else if (a === '-h' || a === '--help') o.help = true;
    else if (a === 'keys') o.cmd = 'keys';
    else if (a.startsWith('-')) {
      process.stderr.write(`websearch: unknown flag ${a}\n`);
      process.exit(2);
    } else o.query.push(a);
  }
  return o;
}

const HELP = `websearch — stacked free-tier web search with failover

USAGE
  websearch [options] <query…>
  websearch keys              show which providers have keys + signup links
  websearch quota             free-allowance use per provider (reads live balances where
                              the API exposes them: linkup, tavily)

OPTIONS
  -n, --num N        results to return (default 5)
  -p, --provider P   force one provider (searxng|linkup|parallel|youcom|tavily|
                     brave|jina|exa|tinyfish|marginalia); ignores cooldown
      --order a,b,c  override priority order
      --json         force JSON output (default when piped/non-TTY)
      --pretty       force human output (default when interactive)
      --timeout MS   per-provider timeout (default 15000)
  -q, --quiet        suppress provider-attempt breadcrumbs on stderr
      --no-cooldown  try exhausted providers in normal order this run
      --intent I     nav|facts|fresh|code|smallweb|general (default: guessed from query)
      --static       use the fixed DEFAULT_ORDER instead of quality/budget ranking

ROUTING      Default order = measured quality for the query's intent x budget pace.
             A metered provider ahead of its free allowance for the period slides
             down; unmetered ones (searxng, tinyfish, marginalia) absorb the rest.
             Usage is counted in ~/.cache/websearch/usage.json. Re-run
             bench/bench2.py to re-measure quality. WEBSEARCH_ROUTING=static = --static.

COOLDOWN     A provider that returns 402/429/432 is moved to the END of the
             order for WEBSEARCH_COOLDOWN_MIN minutes (default 15; 0 disables).
             It is still tried as a last resort, never silently dropped.
  -h, --help

EXIT CODES   0 ok · 2 usage · 3 all providers exhausted · 4 no keys
KEYS         env SEARXNG_URL LINKUP_API_KEY PARALLEL_API_KEY YDC_API_KEY TAVILY_API_KEY
             BRAVE_API_KEY JINA_API_KEY EXA_API_KEY TINYFISH_API_KEY (marginalia: none)
             or ~/.config/websearch/keys.json
             Exa auto-read from ~/.claude.json; TinyFish from ~/.tinyfish/config.json

EXAMPLE (skill/hook)
  websearch "latest claude opus pricing" -n 5 --json
  websearch "breaking news" -p tinyfish -n 8 --json`;

// ------------------------------------------------------------------- cooldown
const CACHE_DIR = process.env.XDG_CACHE_HOME || join(HOME, '.cache');
const COOLDOWN_FILE = join(CACHE_DIR, 'websearch', 'cooldown.json');
const COOLDOWN_MS = (() => {
  const m = Number.parseFloat(process.env.WEBSEARCH_COOLDOWN_MIN ?? '15');
  return Number.isFinite(m) && m > 0 ? m * 60_000 : 0;
})();

function readCooldown() {
  try {
    const j = JSON.parse(readFileSync(COOLDOWN_FILE, 'utf8'));
    return j && typeof j === 'object' ? j : {};
  } catch {
    return {};
  }
}

function writeCooldown(state) {
  try {
    mkdirSync(dirname(COOLDOWN_FILE), { recursive: true });
    writeFileSync(COOLDOWN_FILE, `${JSON.stringify(state, null, 2)}\n`);
  } catch {
    // Cooldown is an optimization; never fail a search because the cache is unwritable.
  }
}

// -------------------------------------------------------------- usage + rank
const USAGE_FILE = join(CACHE_DIR, 'websearch', 'usage.json');
const QUALITY_FILE = join(HOME, '.config', 'websearch', 'quality.json');
const monthKey = (t) => new Date(t).toISOString().slice(0, 7);

function readJson(file) {
  try {
    const j = JSON.parse(readFileSync(file, 'utf8'));
    return j && typeof j === 'object' ? j : {};
  } catch {
    return {};
  }
}

function writeJson(file, obj) {
  try {
    mkdirSync(dirname(file), { recursive: true });
    writeFileSync(file, `${JSON.stringify(obj, null, 2)}\n`);
  } catch {
    // Usage accounting is advisory; never fail a search over it.
  }
}

// Queries charged against the provider's current period.
function usedThisPeriod(p, usage, t) {
  const u = usage[p];
  const b = BUDGET[p];
  if (!u || !b?.period) return 0;
  if (b.period === 'once') return u.total || 0;
  return u.month === monthKey(t) ? u.count || 0 : 0;
}

// 1 while the provider is at or below its pro-rata share of the allowance (+2%); falls toward
// 0.2 as it gets ahead of pace; 0.05 once the allowance is gone.
function paceFactor(p, usage, t) {
  const b = BUDGET[p];
  if (!b?.period) return 1;
  const used = usedThisPeriod(p, usage, t);
  if (used >= b.allowance) return 0.05;
  let elapsed;
  if (b.period === 'month') {
    const d = new Date(t);
    const start = Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), 1);
    const end = Date.UTC(d.getUTCFullYear(), d.getUTCMonth() + 1, 1);
    elapsed = (t - start) / (end - start);
  } else {
    elapsed = Math.min(1, (t - (usage[p]?.first ?? t)) / (365 * 86_400_000));
  }
  // 2% slack so a handful of early queries doesn't reshuffle near-ties.
  const ahead = used / b.allowance - elapsed - 0.02;
  return ahead <= 0 ? 1 : Math.max(0.2, 1 - 2 * ahead);
}

function loadQuality() {
  const q = { ...QUALITY_DEFAULT };
  const file = readJson(QUALITY_FILE).providers || {};
  for (const [p, v] of Object.entries(file)) q[p] = { ...(q[p] || {}), ...v };
  return q;
}

function qualityFor(qual, p, intent) {
  const v = qual[p];
  if (!v) return 0;
  if (intent === 'general') {
    const xs = INTENTS.map((i) => v[i]).filter((x) => typeof x === 'number');
    return xs.length ? xs.reduce((a, b) => a + b, 0) / xs.length : 0;
  }
  return typeof v[intent] === 'number' ? v[intent] : 0;
}

function rankProviders(providers, intent, usage, t) {
  const qual = loadQuality();
  const scored = providers.map((p, i) => {
    const bonus = BUDGET[p]?.period ? 0 : UNMETERED_BONUS;
    const score = (qualityFor(qual, p, intent) + bonus) * paceFactor(p, usage, t);
    return { p, i, score };
  });
  scored.sort((a, b) => b.score - a.score || a.i - b.i);
  return scored;
}

function recordUsage(usage, p, t) {
  const u = usage[p] || { month: monthKey(t), count: 0, total: 0, first: t };
  if (u.month !== monthKey(t)) {
    u.month = monthKey(t);
    u.count = 0;
  }
  u.count = (u.count || 0) + 1;
  u.total = (u.total || 0) + 1;
  u.first = u.first || t;
  usage[p] = u;
}

// ----------------------------------------------------------------------- main
const opts = parseArgs(process.argv.slice(2));
const wantJson = opts.json === null ? !process.stdout.isTTY : opts.json;
const log = (s) => {
  if (!opts.quiet) process.stderr.write(s);
};

if (opts.help) {
  process.stdout.write(`${HELP}\n`);
  process.exit(0);
}

const keys = loadKeys();

if (opts.cmd === 'keys') {
  const rows = DEFAULT_ORDER.map((p) => {
    const keyless = KEYLESS.has(p);
    const have = keyless || !!keys[KEY_ENV[p]];
    let note = keyless ? 'keyless' : have ? 'key set' : `no key  → ${SIGNUP[p]}`;
    const until = readCooldown()[p];
    if (have && until > Date.now()) note += `  (cooling down ${Math.ceil((until - Date.now()) / 60_000)} min)`;
    return `  ${have ? '✓' : '·'} ${p.padEnd(10)} ${note}`;
  });
  const n = DEFAULT_ORDER.filter((p) => KEYLESS.has(p) || keys[KEY_ENV[p]]).length;
  process.stdout.write(`Search providers (${n}/${DEFAULT_ORDER.length} configured):\n${rows.join('\n')}\n`);
  process.exit(0);
}

if (opts.cmd === 'quota') {
  const t = Date.now();
  const usage = readJson(USAGE_FILE);
  const live = {};
  // Live balances, where the provider exposes one. These correct the local count.
  const probes = {
    linkup: async (key) => {
      const r = await doFetch('https://api.linkup.so/v1/credits/balance', { headers: { Authorization: `Bearer ${key}` } }, 10000);
      const j = await r.json();
      if (typeof j.balance !== 'number') throw new Error('no balance');
      return { used: Math.round((20 - j.balance) / 0.005), note: `$${j.balance.toFixed(2)} left` };
    },
    tavily: async (key) => {
      const r = await doFetch('https://api.tavily.com/usage', { headers: { Authorization: `Bearer ${key}` } }, 10000);
      const j = await r.json();
      const used = j.account?.plan_usage;
      if (typeof used !== 'number') throw new Error('no usage');
      return { used, note: `${used}/${j.account.plan_limit} (live; can lag)` };
    },
  };
  for (const [p, fn] of Object.entries(probes)) {
    if (!keys[KEY_ENV[p]]) continue;
    try {
      live[p] = await fn(keys[KEY_ENV[p]]);
      const u = usage[p] || { total: 0, first: t };
      u.month = monthKey(t);
      u.count = Math.max(u.count && u.month === monthKey(t) ? u.count : 0, live[p].used);
      u.total = Math.max(u.total || 0, u.count);
      usage[p] = u;
    } catch (e) {
      live[p] = { note: `live read failed: ${e.message}` };
    }
  }
  writeJson(USAGE_FILE, usage);
  process.stdout.write('provider    period  used/allowance   pace  notes\n');
  for (const p of DEFAULT_ORDER) {
    const have = KEYLESS.has(p) || !!keys[KEY_ENV[p]];
    const b = BUDGET[p];
    const used = usedThisPeriod(p, usage, t);
    const alloc = b?.period ? `${used}/${b.allowance}` : `${usage[p]?.count || 0} (unmetered)`;
    const note = !have ? 'no key' : live[p]?.note || '';
    process.stdout.write(
      `${p.padEnd(11)} ${(b?.period || '-').padEnd(7)} ${alloc.padEnd(16)} ${paceFactor(p, usage, t).toFixed(2).padStart(4)}  ${note}\n`,
    );
  }
  process.exit(0);
}

if (opts.query.length === 0) {
  process.stderr.write(`${HELP}\n`);
  process.exit(2);
}

const query = opts.query.join(' ');
let order = opts.order || (opts.provider ? [opts.provider] : DEFAULT_ORDER.slice());
order = order.filter((p) => PROVIDERS[p]);
const usable = order.filter((p) => KEYLESS.has(p) || keys[KEY_ENV[p]]);

if (usable.length === 0) {
  process.stderr.write(
    `websearch: no API keys for any provider (${order.join(', ')}).\n` +
      `Add at least one free key, then retry. Run 'websearch keys' for signup links.\n`,
  );
  process.exit(4);
}

// Exhausted providers (still inside their cooldown) go to the end of the order, so a
// dead monthly cap stops costing a round-trip on every search. They are demoted, never
// dropped: if everything else fails they are still tried. An explicit -p/--order is
// the caller's choice and is honored as-is.
const now = Date.now();
const cooldown = COOLDOWN_MS ? readCooldown() : {};
const cooling = (p) => cooldown[p] > now;
const explicit = !!(opts.provider || opts.order);
const usage = readJson(USAGE_FILE);
const staticOrder = opts.static || process.env.WEBSEARCH_ROUTING === 'static';
const intent = opts.intent && (INTENTS.includes(opts.intent) || opts.intent === 'general') ? opts.intent : detectIntent(query);
const ranked = explicit || staticOrder ? usable : rankProviders(usable, intent, usage, now).map((x) => x.p);
const tryOrder =
  opts.cooldown && COOLDOWN_MS && !explicit
    ? [...ranked.filter((p) => !cooling(p)), ...ranked.filter(cooling)]
    : ranked;
if (!explicit) log(`intent=${intent} order=${tryOrder.join(',')}\n`);
const coolingSet = new Set(tryOrder.filter(cooling));
let cooldownDirty = false;
const setCooldown = (p, until) => {
  if (!COOLDOWN_MS) return;
  if (until) cooldown[p] = until;
  else if (p in cooldown) delete cooldown[p];
  else return;
  cooldownDirty = true;
};
const flushCooldown = () => {
  if (cooldownDirty) writeCooldown(cooldown);
  writeJson(USAGE_FILE, usage);
};

const attempts = [];
for (const p of tryOrder) {
  log(`→ ${p}${coolingSet.has(p) ? ' (cooling down)' : ''}… `);
  try {
    const results = await PROVIDERS[p](query, opts.num, keys[KEY_ENV[p]], opts.timeout);
    recordUsage(usage, p, Date.now());
    log(`✓ ${results.length} result(s)\n`);
    setCooldown(p, 0);
    // A provider that returns ZERO results is NOT a success — it silently ended the
    // search and the caller saw "the web has nothing". Fall through to the next
    // provider; only accept an empty answer once every provider has been tried.
    if (results.length === 0 && p !== tryOrder[tryOrder.length - 1]) {
      attempts.push({ provider: p, kind: 'empty', status: 200, message: '0 results' });
      continue;
    }
    flushCooldown();
    const payload = { query, intent, provider: p, count: results.length, order: tryOrder, attempts, results };
    if (wantJson) {
      process.stdout.write(`${JSON.stringify(payload, null, 2)}\n`);
    } else {
      process.stdout.write(`\n${results.length} results for "${query}" via ${p}:\n\n`);
      results.forEach((x, i) => {
        process.stdout.write(`${i + 1}. ${x.title}\n   ${x.url}\n`);
        if (x.snippet) process.stdout.write(`   ${x.snippet}\n`);
        process.stdout.write('\n');
      });
    }
    process.exit(0);
  } catch (e) {
    const tag = e.kind === 'exhausted' ? 'exhausted' : e.kind === 'auth' ? 'bad key' : 'error';
    log(`✗ ${tag}${e.status ? ` (${e.status})` : ''}\n`);
    attempts.push({ provider: p, kind: e.kind, status: e.status, message: e.message });
    // A reached API that answered with an error still counts against most quotas.
    if (e.status) recordUsage(usage, p, Date.now());
    // Unmetered providers only rate-limit, so their cooldown is short.
    const coolFor = BUDGET[p]?.period ? COOLDOWN_MS : Math.min(COOLDOWN_MS, 60_000);
    if (e.kind === 'exhausted') setCooldown(p, Date.now() + coolFor);
    // auth failures and exhaustion both → just move on to the next provider.
  }
}

// Every usable provider failed.
flushCooldown();
const summary = { query, error: 'all_providers_failed', attempts };
if (wantJson) process.stdout.write(`${JSON.stringify(summary, null, 2)}\n`);
else {
  process.stderr.write(`All ${usable.length} provider(s) failed:\n`);
  for (const a of attempts) process.stderr.write(`  ${a.provider}: ${a.kind} ${a.status || ''} ${a.message || ''}\n`);
}
process.exit(3);
